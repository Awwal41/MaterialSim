# OpenAI API Key for LLM functionality (optional - only needed for chat)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Materials Project API Key (optional - only needed for database queries)
MP_API_KEY=YOUR_MATERIALS_PROJECT_API_KEY

# NOMAD API Key (optional)
NOMAD_API_KEY=your_nomad_api_key_here

# LAMMPS executable path
LAMMPS_EXECUTABLE=lmp

# Default simulation parameters
DEFAULT_TEMPERATURE=300
DEFAULT_PRESSURE=1.0
DEFAULT_TIMESTEP=0.001

# Output directories
SIMULATION_OUTPUT_DIR=./simulations
ANALYSIS_OUTPUT_DIR=./analysis
VISUALIZATION_OUTPUT_DIR=./visualizations

# Logging level
LOG_LEVEL=INFO

# Voice (JARVIS) settings
JARVIS_VOICE=en-GB-RyanNeural
VOICE_AUTO_SPEAK=true
